{
  "name": "dsh-video-watching",
  "version": "0.9.0",
  "description": "Plan first, pay once: video_plan checks whether maxTotalSheets covers the whole clip and hands out a planId, video_watch only executes that approved plan, and every batch is written into a markdown viewing record on disk. Sampling follows accumulated change, one image per delivery unit (1080p / ~384 tokens).",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./plan": "./lib/plan.js",
    "./grid": "./lib/grid.js",
    "./time": "./lib/time.js",
    "./scan": "./lib/scan.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "icon.png",
    "art/*.png",
    "README.md",
    "使用手册.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "contract": "node scripts/verify-agent-contract.mjs",
    "real": "node scripts/verify-real-output.mjs",
    "clean": "node scripts/clean.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "video",
    "adaptive-sampling",
    "contact-sheet",
    "keyframe",
    "ffmpeg",
    "multimodal"
  ],
  "license": "MIT",
  "author": "ChengYK (https://github.com/Murphy2000-cyk)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Murphy2000-cyk/dsh-video-watching.git"
  },
  "homepage": "https://github.com/Murphy2000-cyk/dsh-video-watching#readme",
  "bugs": {
    "url": "https://github.com/Murphy2000-cyk/dsh-video-watching/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
